{
  "manifest_version": 3,
  "name": "YouTube Adblocker By Lokesh.R",
  "version": "9.0.0",
  "description": "Blocks YouTube & YouTube Music ads and starts videos instantly.",
  "minimum_chrome_version": "111",

  "permissions": [
    "declarativeNetRequest",
    "scripting"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://*.doubleclick.net/*",
    "https://*.googlesyndication.com/*",
    "https://*.googleadservices.com/*",
    "https://*.google.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}